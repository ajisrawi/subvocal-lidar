# CMake toolchain file: GNU Arm Embedded (arm-none-eabi). ARM_GCC_DIR = the toolchain's bin folder.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT ARM_GCC_DIR)
  if(DEFINED ENV{ARM_GCC_DIR})
    set(ARM_GCC_DIR $ENV{ARM_GCC_DIR})
  else()
    file(TO_CMAKE_PATH "$ENV{USERPROFILE}" HOME_DIR)
    set(ARM_GCC_DIR "${HOME_DIR}/pico-tools/arm/bin")
  endif()
endif()
set(EXE "")
if(CMAKE_HOST_WIN32)
  set(EXE ".exe")
endif()
set(CMAKE_C_COMPILER "${ARM_GCC_DIR}/arm-none-eabi-gcc${EXE}")
set(CMAKE_ASM_COMPILER "${ARM_GCC_DIR}/arm-none-eabi-gcc${EXE}")
set(CMAKE_OBJCOPY "${ARM_GCC_DIR}/arm-none-eabi-objcopy${EXE}" CACHE FILEPATH "")
set(CMAKE_SIZE "${ARM_GCC_DIR}/arm-none-eabi-size${EXE}" CACHE FILEPATH "")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
